{
  "_comment": "Declarative field registry. Adding a field here (and referencing it from a template definition) makes it appear in the dashboard automatically. scope=shared: entered once per project; scope=template: shown only when one of `templates` is selected.",
  "groups": [
    {
      "key": "identification",
      "label": "Project identification"
    },
    {
      "key": "parties",
      "label": "Owner, developer & contractor"
    },
    {
      "key": "location",
      "label": "Location"
    },
    {
      "key": "description",
      "label": "Description & usage"
    },
    {
      "key": "new_project",
      "label": "New project"
    },
    {
      "key": "document",
      "label": "Document-specific details"
    }
  ],
  "fields": [
    {
      "key": "project_id",
      "label": "Project ID",
      "labelAr": "رقم المشروع",
      "type": "text",
      "dir": "ltr",
      "group": "identification",
      "scope": "shared",
      "maxLength": 60,
      "placeholder": "e.g. B2N-2026-000123"
    },
    {
      "key": "municipality_project_number",
      "label": "Municipality project number",
      "labelAr": "رقم المشروع بالبلدية",
      "type": "text",
      "dir": "ltr",
      "group": "identification",
      "scope": "shared",
      "maxLength": 60,
      "optional": true
    },
    {
      "key": "bank_project_number",
      "label": "Project No / FAB ID (loan no.)",
      "labelAr": "رقم القرض / FAB ID",
      "type": "text",
      "dir": "ltr",
      "group": "identification",
      "scope": "shared",
      "maxLength": 60,
      "optional": true,
      "placeholder": "e.g. 12345678/01/000001",
      "help": "The bank's (FAB) project / loan number printed on the bank papers. Not the Project ID or the municipality project number."
    },
    {
      "key": "date",
      "label": "Document date",
      "labelAr": "التاريخ",
      "type": "date",
      "group": "identification",
      "scope": "shared",
      "default": "today",
      "help": "Printed as DD/MM/YYYY."
    },
    {
      "key": "project_start_date",
      "label": "Project start date",
      "labelAr": "تاريخ بداية المشروع",
      "type": "date",
      "group": "identification",
      "scope": "shared",
      "optional": true
    },
    {
      "key": "project_end_date",
      "label": "Project end date",
      "labelAr": "تاريخ نهاية المشروع",
      "type": "date",
      "group": "identification",
      "scope": "shared",
      "optional": true
    },
    {
      "key": "owner_name_ar",
      "label": "Owner name (Arabic)",
      "labelAr": "اسم المالك",
      "type": "text",
      "dir": "rtl",
      "group": "parties",
      "scope": "shared",
      "maxLength": 1000,
      "pair": "owner_name_en",
      "help": "Several owners: separate them with « و »."
