  "category": "MECHANICAL REVIEW متطلبات المراجعة الميكانيكية",
  "order": 11,
  "projectType": "occupancy",
  "source": "عدم وجود مصاعد في المشروع.docx",
  "format": "docx",
  "layoutTolerance": 0.003,
  "sanitize": [
    {
      "op": "trim_leading_empty_paragraphs",
      "keep": 1,
      "optional": true
