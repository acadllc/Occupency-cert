{
  "key": "archive-drawings-explanation",
  "version": 4,
  "status": "verified",
  "name": "Explanation of Architectural & Structural Archive Drawings",
  "nameAr": "توضيح بخصوص مخططات الأرشيف المعمارية والإنشائية",
  "description": "Letter explaining the archived architectural (ARCH.PDF) and structural (STRUC.PDF) drawings attached to the application.",
  "category": "ARCH REVIEW المراجعة المعمارية",
  "order": 3,
  "projectType": "occupancy",
  "source": "03EXPLAIN FOR ARCHIVE.docx",
  "format": "docx",
  "sanitize": [
    {
      "op": "date_field",
      "slot": "date"
    },
    {
      "op": "cell",
      "label": "رقم المشروع:",
      "offset": 1,
      "slot": "project_id"
    },
    {
      "op": "cell",
      "label": "رقم القسيمة:",
      "offset": 1,
      "slot": "plot"
    },
    {
      "op": "cell",
      "label": "اسم المالك:",
      "offset": 1,
      "slot": "owner"
    },
    {
      "op": "cell",
      "label": "المنطقة/الحي:",
      "offset": 1,
      "slot": "area"
    },
    {
      "op": "remove_image",
      "target": "media/image1.png"
    },
    {
      "op": "text",
      "contains": "رخصة البناء",
      "old": ", أيضا تم إضافة  ملف يحتوي على رخصة البناء",
      "slot": "note",
      "reserve": 44,
      "rtl": true
    },
    {
      "op": "insert_after",
      "contains": "الاستشاري",
      "occurrence": -1,
      "slot": "stamp"
    },
    {
      "op": "footer_align",
      "pattern": "AACM-CP|^V\\d+\\.\\d",
      "align": "right"
    }
  ],
  "slots": {
    "date": {
      "kind": "inline",
      "width": 120
    },
    "project_id": {
      "kind": "cell"
    },
    "plot": {
      "kind": "cell"
    },
    "owner": {
      "kind": "cell"
    },
    "area": {
      "kind": "cell"
    },
    "note": {
      "kind": "gap",
      "width": 240
    },
    "stamp": {
      "kind": "line_leftmost"
    }
  },
  "fields": [
    {
      "slot": "date",
      "value": "date",
      "font": "tajawal",
      "dir": "rtl",
      "align": "right",
      "padding": [
        0,
        0,
        2,
        0
      ]
    },
    {
      "slot": "project_id",
      "value": "project_id",
      "font": "tajawal",
      "size": 11,
      "dir": "ltr",
      "align": "center",
      "padding": [
        3,
        1,
        3,
        1
      ]
    },
    {
      "slot": "plot",
      "value": "plot_number",
      "font": "tajawal",
      "size": 11,
      "dir": "ltr",
      "align": "center",
      "padding": [
        3,
        1,
        3,
        1
      ]
    },
    {
      "slot": "owner",
      "value": "owner_name_ar",
      "font": "tajawal",
      "size": 11,
      "align": "center",
      "multiline": true,
      "padding": [
        3,
        1,
        3,
        1
      ]
    },
    {
      "slot": "area",
      "value": "{area_ar} / {sector_ar}",
      "font": "tajawal",
      "size": 11,
      "align": "center",
      "multiline": true,
      "padding": [
        3,
        1,
        3,
        1
      ]
    },
    {
      "slot": "note",
      "value": ", {archive_note_ar}",
      "font": "tajawal",
      "size": 12,
      "align": "right",
      "dir": "rtl",
      "padding": [
        0,
        0,
        0,
        0
      ]
    },
    {
      "slot": "stamp",
      "stamp": {
        "size": 115,
        "anchor": "below",
        "dy": 4
      }
    }
  ]
}
