{
  "key": "drainage-inspection-report",
  "version": 2,
  "status": "verified",
  "name": "Internal Drainage Inspection Report",
  "nameAr": "تقرير فحص شبكة الصرف الصحي الداخلي ووصلها بالمناهيل",
  "description": "Consultant report confirming inspection of the internal drainage network and its connections to the manholes.",
  "category": "PLUMBING REVIEW متطلبات أعمال السباكة",
  "order": 4,
  "projectType": "occupancy",
  "source": "04Inspection report for the internal drainage system and its connection to the internal manholes تقرير فحص نظام الصرف الداخلي ووصلاته بغرف التفتيش ال.docx",
  "format": "docx",
  "sanitize": [
    {
      "op": "trim_leading_empty_paragraphs",
      "keep": 1,
      "optional": true
    },
    {
      "op": "date_field",
      "slot": "date"
    },
    {
      "op": "cell",
      "label": "اسم المالك",
      "offset": -2,
      "slot": "owner"
    },
    {
      "op": "cell",
      "label": "اسم الاستشاري",
      "offset": -2,
      "slot": "consultant"
    },
    {
      "op": "cell",
      "label": "موقع المشروع",
      "offset": -2,
      "slot": "location"
    },
    {
      "op": "cell",
      "label": "مكونات المشروع",
      "offset": -2,
      "slot": "components"
    },
    {
      "op": "insert_after",
      "contains": "الإستشاري",
      "occurrence": -1,
      "slot": "stamp"
    }
  ],
  "slots": {
    "date": {
      "kind": "inline",
      "width": 120
    },
    "owner": {
      "kind": "cell"
    },
    "consultant": {
      "kind": "cell"
    },
    "location": {
      "kind": "cell"
    },
    "components": {
      "kind": "cell"
    },
    "stamp": {
      "kind": "line_leftmost"
    }
  },
  "fields": [
    {
      "slot": "date",
      "value": "date",
      "font": "din",
      "dir": "rtl",
      "align": "right",
      "padding": [
        0,
        0,
        2,
        0
      ]
    },
    {
      "slot": "owner",
      "value": "owner_name_ar",
      "font": "sans",
      "size": 12,
      "align": "right",
      "multiline": true,
      "padding": [
        6,
        2,
        6,
        2
      ]
    },
    {
      "slot": "consultant",
      "value": "$consultant_name_ar",
      "font": "sans",
      "size": 12,
      "align": "right",
      "multiline": true,
      "padding": [
        6,
        2,
        6,
        2
      ]
    },
    {
      "slot": "location",
      "value": "@project_location_ar",
      "font": "sans",
      "size": 12,
      "align": "right",
      "multiline": true,
      "padding": [
        6,
        2,
        6,
        2
      ]
    },
    {
      "slot": "components",
      "value": "project_components_ar",
      "font": "sans",
      "size": 12,
      "align": "right",
      "multiline": true,
      "padding": [
        6,
        2,
        6,
        2
      ]
    },
    {
      "slot": "stamp",
      "stamp": {
        "size": 110,
        "anchor": "right",
        "dx": 6,
        "dy": 0
      }
    }
  ]
}
