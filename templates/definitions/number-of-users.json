{
  "key": "number-of-users",
  "version": 2,
  "status": "verified",
  "name": "Number of Users Letter",
  "nameAr": "عدد المستخدمين",
  "description": "Letter to the Department of Municipalities and Transport confirming the number of building users.",
  "category": "ARCH REVIEW المراجعة المعمارية",
  "projectType": "occupancy",
  "source": "02NOMBER OF USERS.docx",
  "format": "docx",
  "sanitize": [
    {
      "op": "trim_leading_empty_paragraphs",
      "keep": 1,
      "optional": true
    },
    {
      "op": "date_field",
      "slot": "date"
    },
    {
      "op": "cell",
      "label": "اسم المالك",
      "offset": -2,
      "slot": "owner"
    },
    {
      "op": "cell",
      "label": "اسم الاستشاري",
      "offset": -2,
      "slot": "consultant"
    },
    {
      "op": "cell",
      "label": "موقع المشروع",
      "offset": -2,
      "slot": "location"
    },
    {
      "op": "cell",
      "label": "مكونات المشروع",
      "offset": -2,
      "slot": "components"
    },
    {
      "op": "text",
      "contains": "عدد المستخدين للمشروع",
      "old": "أسره واحده فقط",
      "slot": "users"
    },
    {
      "op": "insert_after",
      "contains": "الإستشاري",
      "occurrence": -1,
      "slot": "stamp"
    }
  ],
  "slots": {
    "date": {
      "kind": "inline",
      "width": 120
    },
    "owner": {
      "kind": "cell"
    },
    "consultant": {
      "kind": "cell"
    },
    "location": {
      "kind": "cell"
    },
    "components": {
      "kind": "cell"
    },
    "users": {
      "kind": "inline",
      "width": 200
    },
    "stamp": {
      "kind": "line_leftmost"
    }
  },
  "fields": [
    {
      "slot": "date",
      "value": "date",
      "font": "din",
      "size": 14,
      "dir": "rtl",
      "align": "right",
      "padding": [
        0,
        0,
        2,
        0
      ]
    },
    {
      "slot": "owner",
      "value": "owner_name_ar",
      "font": "sans",
      "size": 12,
      "align": "right",
      "multiline": true,
      "padding": [
        6,
        2,
        6,
        2
      ]
    },
    {
      "slot": "consultant",
      "value": "$consultant_name_ar",
      "font": "sans",
      "size": 12,
      "align": "right",
      "multiline": true,
      "padding": [
        6,
        2,
        6,
        2
      ]
    },
    {
      "slot": "location",
      "value": "@project_location_ar",
      "font": "sans",
      "size": 12,
      "align": "right",
      "multiline": true,
      "padding": [
        6,
        2,
        6,
        2
      ]
    },
    {
      "slot": "components",
      "value": "project_components_ar",
      "font": "sans",
      "size": 12,
      "align": "right",
      "multiline": true,
      "padding": [
        6,
        2,
        6,
        2
      ]
    },
    {
      "slot": "users",
      "value": "number_of_users_ar",
      "font": "din",
      "align": "right",
      "dir": "rtl",
      "padding": [
        0,
        0,
        0,
        0
      ]
    },
    {
      "slot": "stamp",
      "stamp": {
        "size": 110,
        "anchor": "right",
        "dx": 6,
        "dy": 0
      }
    }
  ]
}
