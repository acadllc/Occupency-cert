# Copy to .env.local (git-ignored). Only PUBLIC values belong here.
# Supabase -> Project Settings -> API: Project URL and the publishable (anon) key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Never put the secret / service_role key or the database password in any VITE_ variable.
